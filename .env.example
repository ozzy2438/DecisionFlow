DECISIONFLOW_ENVIRONMENT=development
DECISIONFLOW_DATABASE_URL=postgresql+psycopg://decisionflow:decisionflow@postgres:5432/decisionflow
DECISIONFLOW_LOG_LEVEL=INFO
DECISIONFLOW_MLFLOW_TRACKING_URI=http://mlflow:5000
DECISIONFLOW_MLFLOW_EXPERIMENT=decisionflow-sla-risk
DECISIONFLOW_MLFLOW_MODEL_NAME=decisionflow-sla-risk
DECISIONFLOW_MLFLOW_MODEL_ALIAS=candidate
DECISIONFLOW_TEMPORAL_ADDRESS=temporal:7233
DECISIONFLOW_TEMPORAL_NAMESPACE=default
DECISIONFLOW_TEMPORAL_TASK_QUEUE=decisionflow-p2p
DECISIONFLOW_ORCHESTRATION_MODE=temporal
# Set to openai only when the project-prefixed key is supplied at runtime.
# Template remains clearly labeled and receives no host-level OpenAI credential.
DECISIONFLOW_LLM_PROVIDER=template
DECISIONFLOW_OPENAI_API_KEY=
DECISIONFLOW_LLM_MODEL=gpt-5.6
DECISIONFLOW_CORS_ORIGINS=http://localhost:18766
DECISIONFLOW_API_PORT=18765
DECISIONFLOW_UI_PORT=18766
DECISIONFLOW_TEMPORAL_UI_PORT=18767
DECISIONFLOW_PROMETHEUS_PORT=18768
